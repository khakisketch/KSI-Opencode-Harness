# Based on Moby docker-default (Apache-2.0); optional, separately approved host policy.
abi <abi/4.0>,
#include <tunables/global>
profile ksi-codex-userns flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  network unix,
  deny network alg,
  deny network vsock,
  capability,
  file,
  userns,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (send,receive) peer=ksi-codex-userns,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  # Nested bubblewrap only. Drop ALL outer container capabilities separately.
  mount options=(rw, slave),
  mount options=(rw, rslave),
  mount options=(rw, silent, rslave),
  mount options=(rw, private),
  mount options=(rw, rprivate),
  mount options=(rw, silent, rprivate),
  mount options=(rw, bind),
  mount options=(rw, rbind),
  mount options=(ro, remount, bind),
  mount options=(rw, remount, bind),
  mount options=(ro, nosuid, nodev, remount, bind, silent, relatime),
  mount options=(ro, nosuid, nodev, noexec, remount, bind, silent, relatime),
  mount options=(rw, nosuid, nodev, remount, bind, silent, relatime),
  mount options=(rw, nosuid, nodev, noexec, remount, bind, silent, relatime),
  mount fstype=tmpfs,
  mount fstype=proc,
  mount fstype=devpts,
  pivot_root,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  ptrace (trace,tracedby,read,readby) peer=ksi-codex-userns,
}
