{
  "name": "ksi-opencode-harness",
  "version": "0.5.0-beta.7",
  "description": "Installer for three optional native OpenCode V2 agents",
  "type": "module",
  "bin": {
    "ksi-opencode": "./bin/ksi-opencode.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/khakisketch/KSI-Opencode-Harness"
  },
  "files": [
    "bin/ksi-opencode.mjs",
    "src/native-bundle.mjs",
    "src/native-roles.mjs",
    "templates/agents/developer.md",
    "templates/agents/test-runner.md",
    "templates/agents/reviewer.md",
    "README.md",
    "INSTALL.md",
    "docs/architecture.md",
    "docs/integrations/opendesign.md",
    "docs/execution.md",
    "docs/troubleshooting.md",
    "docs/verification.md",
    "docs/walkthrough.md",
    "docs/assets",
    "examples/project-AGENTS.md",
    "examples/autonomous-development.md",
    "opencode.jsonc.example",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/ksi-opencode.mjs && node --check src/native-bundle.mjs && node --check src/native-roles.mjs && node --test",
    "check:package": "node scripts/check-package.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "agent",
    "harness",
    "routing",
    "opendesign"
  ]
}
