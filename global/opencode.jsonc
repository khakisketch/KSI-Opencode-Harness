{
  // Native agents, model routing and MCP tools; no separate workflow runtime.
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "update": "notify",
  "experimental": {
    // Root = 0. Usually use 1-2 levels; a useful third level is allowed, never required.
    "subagent_depth": 3
  },
  "mcp": {
    // Lead owns assigned whole-task delivery; task-specific evidence gathering happens inside the assigned scope when useful.
    // Mobbin is an optional paid service: this operator enables it, but the harness works without it.
    // V2 Native shape: servers under mcp.servers are default-enabled; set "disabled": true to deactivate.
    "servers": {
      "mobbin": {
        "type": "remote",
        "url": "https://api.mobbin.com/mcp"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "oauth": false
      }
    }
  },
  "agents": {
    // Five operating profiles: Build (primary), Plan (mode all as a deliberate
    // consultation exception), Lead (custom whole-task owner), General and
    // Explore (Native breadth). The superseded specialist operating files were
    // removed with user approval (contents survive only in private backups);
    // the archived Architect file stays outside discovery and is installed
    // nowhere.
    "build": {
      "description": "Default product execution lead. Grounds in whole-product purpose, user workflows and project authority docs before decomposing work; owns product goal, planning, coherent workstream assignment, dependency and parallel-vs-sequential orchestration, integration, final acceptance and the next approved outcome. Checks Lead outputs rather than managing every General worker; direct implementation or direct General use stays permitted for simple or appropriate work, with no mandatory Lead routing by complexity, file count or domain. Verifies actual file diffs and evidence — plus rendered initial viewports where the outcome has a UI surface — before accepting child work. Model choice does not transfer ownership.",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "plan", "effect": "allow" },
        { "action": "subagent", "resource": "lead", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    },
    "plan": {
      "description": "Direction advisor by deliberate consultation exception: user-selectable or optional Build/Lead advisory call. Reconciles ledgers against latest commits, working tree and actual files to exclude already-implemented items first; advises on priorities, sequence and alternatives without implementing, authorizing implementation, approving requirements/products, or approving/mandating/vetoing independent verification; never a forced stage, approval gate or review dispatcher. Analysis-only delegation (General/Explore) happens under explicit call-time boundaries, never as an implementation bypass.",
      "mode": "all",
      "model": "opencode-go/muse-spark-1.3-contributor#xhigh"
    },
    "explore": {
      "description": "Read-centric searcher. Uses Native code and web search with read-only analysis, reporting its searched scope; writes nothing, calls no subagent, owns no acceptance and performs no implementation.",
      "model": "opencode-go/muse-spark-1.3-contributor#medium",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "general": {
      "description": "Broad Native task-execution worker. Owns its assigned task execution inside the given objective and scope — investigating, deciding locally, executing multi-file research/design/implementation/test/repair with UX, research and security skills as needed and no configuration whitelist — self-verifying, completing and returning results normally, and reporting material uncertainty upward. Gains no child/question capabilities and takes on no mandated independent review. Model choice does not transfer ownership.",
      "model": "opencode-go/muse-spark-1.3-contributor#high",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "providers": {
    "opencode-go": {
      "models": {
        "muse-spark-1.3-contributor": {
          // This endpoint accepts auto only. Native step-limit execution guards remain unchanged.
          "body": { "tool_choice": "auto" }
        }
      }
    }
  }
}
