{
  // Native agents, model routing and MCP tools; no separate workflow runtime.
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "update": "notify",
  "experimental": {
    // Build -> Architect -> implementation/research/critique; a ceiling, not a required chain.
    "subagent_depth": 2
  },
  "mcp": {
    // Design Architect owns design outcomes; UX Scout optionally gathers evidence.
    // Mobbin is an optional paid service: this operator enables it, but the harness works without it.
    "mobbin": {
      "type": "remote",
      "url": "https://api.mobbin.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "oauth": false,
      "timeout": 30000
    }
  },
  "agents": {
    // Native Markdown owns custom-role prompts and permissions; these are user routing preferences.
    "build": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "plan", "effect": "allow" },
        { "action": "subagent", "resource": "design-architect", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "ux-scout", "effect": "allow" },
        { "action": "subagent", "resource": "ui-ux-critic", "effect": "allow" },
        { "action": "subagent", "resource": "product-reviewer", "effect": "allow" }
      ]
    },
    "plan": {
      "mode": "all",
      "model": "openai/gpt-6.1-sol#xhigh",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    },
    "explore": { "model": "opencode-go/muse-spark-1.3-contributor#low", "steps": 20 },
    "general": { "model": "opencode-go/muse-spark-1.3-contributor#high" }
  },
  "providers": {
    "opencode-go": {
      "models": {
        "muse-spark-1.3-contributor": {
          // This endpoint accepts auto only. Native step-limit execution guards remain unchanged.
          "body": { "tool_choice": "auto" }
        }
      }
    }
  },
  "tool_output": {
    "max_lines": 600,
    "max_bytes": 24576
  },
  "compaction": {
    "auto": true,
    // V2 retains context by token budget; V1 prune/tail-turn controls have no V2 equivalent.
    "keep": { "tokens": 8192 },
    "buffer": 4096
  }
}
