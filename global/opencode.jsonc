{
  // Native agents, model routing and MCP tools; no separate workflow runtime.
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "experimental": {
    // Optional Native task state for multi-step work; not a completion gate.
    "todo": true,
    // Root = 0. Only direct children; children are leaves and start no
    // subagents of their own. Breadth (parallel siblings) is unaffected.
    "subagent_depth": 1
  },
  "mcp": {
    // Task-specific evidence gathering happens inside the assigned scope when useful.
    // Mobbin is an optional paid service: this operator enables it, but the harness works without it.
    // V2 Native shape: servers under mcp.servers are default-enabled; set "disabled": true to deactivate.
    "servers": {
      "mobbin": {
        // Optional paid service; enabled by the operator. Disable to deactivate.
        "type": "remote",
        "url": "https://api.mobbin.com/mcp",
        "disabled": false
      },
      // Alternative path: the OpenCode plugin "@upstash/context7-opencode".
      // Use exactly one of the MCP server or the plugin; enabling both
      // registers the same Context7 tools twice.
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "oauth": false
      }
    }
  },
  "agents": {
    // Native Build/Plan/General/Explore. Build is the sole development
    // owner; there is no intermediate owner role. Plan advises, General
    // executes bounded tasks, Explore investigates, Build judges UI.
    "build": {
      "description": "Owns the approved goal end to end: investigates, designs, implements, integrates and verifies. Delegates bounded work when it pays; creates worktrees only for parallel implementation, owns integration, and never force-removes one. No extra sessions or worktrees for simple tasks.",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "plan", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    },
    "plan": {
      "description": "Advises on complex or uncertain work: alternatives, causes, risks and a work plan. No implementation, approval or task ownership.",
      "mode": "all",
      // Portable source pins no model; choose locally per docs/development.md.
      // Analysis can use a read-centric leaf, not an execution or recursive agent.
      // Native Plan edit rules remain; strict non-mutation still needs session/OS restrictions.
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    },
    "explore": {
      // Portable source pins no model; choose locally per docs/development.md
      // (this Mac uses OpenCode Go DeepSeek V4.1 Flash High).
    },
    "general": {
      "description": "Executes and verifies bounded tasks independently; returns changed behavior, checks and risks."
    }
  },
  "providers": {
    "opencode-go": {
      "models": {
        "muse-spark-1.3-contributor": {
          // This endpoint accepts auto only. Native step-limit execution guards remain unchanged.
          "body": { "tool_choice": "auto" }
        }
      }
    }
  }
}
