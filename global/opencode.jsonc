{
  // Native agents, model routing and MCP tools; no separate workflow runtime.
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "update": "notify",
  "experimental": {
    // Root = 0. Usually use 1-2 levels; a useful third level is allowed, never required.
    "subagent_depth": 3
  },
  "mcp": {
    // Design owns UI delivery; Research gathers task-specific evidence when useful.
    // Mobbin is an optional paid service: this operator enables it, but the harness works without it.
    "mobbin": {
      "type": "remote",
      "url": "https://api.mobbin.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "oauth": false,
      "timeout": 30000
    }
  },
  "agents": {
    // Native Markdown owns custom-role prompts and permissions; these are user routing preferences.
    // Architect's original file is preserved under docs/archive/agents/, outside
    // Native discovery; it is excluded from every default subagent edge.
    "build": {
      "description": "Default product execution lead. Owns implementation coordination, integration, testing, final acceptance and the next approved development outcome. Routes multi-file/state/recovery technical units to Engineer (not General), verifies actual file diffs and rendered initial viewports before accepting child work, and carries approved prototypes through to real product wiring.",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "plan", "effect": "allow" },
        { "action": "subagent", "resource": "engineer", "effect": "allow" },
        { "action": "subagent", "resource": "design", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "research", "effect": "allow" },
        { "action": "subagent", "resource": "critic", "effect": "allow" }
      ]
    },
    "plan": {
      "description": "Requirements and planning advisor. Reconciles docs/ledgers against latest commits, working tree and actual files to exclude already-implemented items first; uses Explore, Research and Critic for analysis without authorizing implementation or calling implementation-capable roles.",
      "mode": "all",
      "model": "opencode-go/muse-spark-1.3-contributor#xhigh",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "research", "effect": "allow" },
        { "action": "subagent", "resource": "critic", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    },
    "explore": {
      "description": "Read-only local code locator. Finds exact file paths, line ranges, symbols and call sites and states searched scope; never declares features unimplemented, evaluates whole-project completion, or makes design/architecture judgments.",
      "model": "opencode-go/muse-spark-1.3-contributor#low",
      "steps": 20,
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" }
      ]
    },
    "general": {
      "description": "Bounded implementation worker. Executes one already-decided, file-scoped slice, verifies actual file diffs and targeted checks, and returns; if cross-file design, state/auth architecture, or multi-round coordination emerges, stops and returns to Engineer or Design. Model choice does not transfer ownership.",
      "model": "opencode-go/muse-spark-1.3-contributor#high",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "vercel-react-best-practices", "effect": "allow" },
        { "action": "skill", "resource": "evolving-apis-and-schemas", "effect": "allow" },
        { "action": "skill", "resource": "building-accessible-interfaces", "effect": "allow" },
        { "action": "skill", "resource": "playwright-cli", "effect": "allow" },
        { "action": "skill", "resource": "opencode", "effect": "allow" }
      ]
    }
  },
  "providers": {
    "opencode-go": {
      "models": {
        "muse-spark-1.3-contributor": {
          // This endpoint accepts auto only. Native step-limit execution guards remain unchanged.
          "body": { "tool_choice": "auto" }
        }
      }
    }
  },
  "tool_output": {
    "max_lines": 600,
    "max_bytes": 24576
  },
  "compaction": {
    "auto": true,
    // V2 retains context by token budget; V1 prune/tail-turn controls have no V2 equivalent.
    "keep": { "tokens": 8192 },
    "buffer": 4096
  }
}
