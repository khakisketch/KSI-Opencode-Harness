{
  // Native agents, model routing and MCP tools; no separate workflow runtime.
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "experimental": {
    // Root = 0. Usually use 1-2 levels; a useful third level is allowed, never required.
    "subagent_depth": 3
  },
  "mcp": {
    // Lead owns assigned whole-task delivery; task-specific evidence gathering happens inside the assigned scope when useful.
    // Mobbin is an optional paid service: this operator enables it, but the harness works without it.
    // V2 Native shape: servers under mcp.servers are default-enabled; set "disabled": true to deactivate.
    "servers": {
      "mobbin": {
        "type": "remote",
        "url": "https://api.mobbin.com/mcp"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "oauth": false
      }
    }
  },
  "agents": {
    // Native Build/Plan/General/Explore plus the custom Lead profile.
    "build": {
      "description": "Owns product planning, workstreams, integration and final acceptance; implements directly or delegates.",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "plan", "effect": "allow" },
        { "action": "subagent", "resource": "lead", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    },
    "plan": {
      "description": "Advises on direction and priorities within analysis-only scope; neither implements nor approves.",
      "mode": "all",
      "model": "openai/gpt-6.1-sol#high"
    },
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#medium"
    },
    "general": {
      "description": "Executes and verifies assigned tasks independently; returns results and material risks.",
      "model": "opencode-go/muse-spark-1.3-contributor#high"
    }
  },
  "providers": {
    "opencode-go": {
      "models": {
        "muse-spark-1.3-contributor": {
          // This endpoint accepts auto only. Native step-limit execution guards remain unchanged.
          "body": { "tool_choice": "auto" }
        }
      }
    }
  }
}
