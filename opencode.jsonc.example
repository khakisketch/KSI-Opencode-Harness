{
  "$schema": "https://opencode.ai/config.json",
  // KSI's standalone installer writes four custom native agents/*.md files
  // next to this configuration file. Do not register KSI in plugins.
  // Built-in Build, Plan, and Explore keep their original system prompts.
  // Preserve your existing model, variant, positive steps, permissions,
  // provider, MCP, and unrelated settings when adopting KSI.
  "agents": {
    "developer": {
      "model": "provider/model#variant",
      "steps": 80
    }
  },
  "plugins": [
    // Optional, independent user-owned plugins may remain here.
  ]
}
