{
  "$schema": "https://opencode.ai/config.json",
  // Optional V2 local renderer, disabled by default.
  // If enabled, npx may download and execute the MCP package. Browser setup is separate.
  // Keep browser installation and agent/model settings separate.
  // design-previews/ is an artifact convention, not a permission boundary.
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx", "--yes", "@playwright/mcp@0.0.80",
          "--headless", "--isolated", "--block-service-workers",
          "--browser", "chrome", "--caps", "vision",
          "--image-responses", "allow",
          "--allowed-origins", "http://127.0.0.1:*;http://localhost:*",
          "--output-dir", "design-previews/artifacts"
        ],
        "enabled": false
      }
    }
  }
}
